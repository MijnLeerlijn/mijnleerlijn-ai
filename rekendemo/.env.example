# API-sleutel van OpenAI. Nooit een echte sleutel committen.
# Wordt zowel voor de tekstgeneratie als voor de tekeningen gebruikt.
OPENAI_API_KEY=

# Model voor de opgaven. Laat leeg voor de standaard (gpt-5).
OPENAI_MODEL=

# Model voor de tekeningen. Laat leeg voor de standaard (gpt-image-1-mini).
OPENAI_IMAGE_MODEL=

# Optioneel: formaat en kwaliteit van de tekeningen.
# Standaard 1536x1024 (liggend) en kwaliteit "medium".
# OPENAI_IMAGE_SIZE=1536x1024
# OPENAI_IMAGE_QUALITY=medium

# Optioneel: alternatief endpoint, bijvoorbeeld een lokale testserver.
# OPENAI_BASE_URL=

# Optioneel: providers (op dit moment alleen "openai").
# AI_PROVIDER=openai
# IMAGE_PROVIDER=openai
