# API-sleutel van OpenAI. Nooit een echte sleutel committen.
OPENAI_API_KEY=

# Optioneel: het model dat gebruikt wordt (standaard gpt-5).
# OPENAI_MODEL=gpt-5

# Optioneel: alternatief endpoint, bijvoorbeeld een lokale testserver.
# OPENAI_BASE_URL=

# Optioneel: AI-provider (op dit moment alleen "openai").
# AI_PROVIDER=openai
