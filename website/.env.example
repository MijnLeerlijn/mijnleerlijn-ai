# Kopieer naar .env en vul in voor lokale ontwikkeling. Zie
# docs/IMPLEMENTATION-PLAN.md Fase 4 en het Fase 4-opleveringsrapport voor
# toelichting per variabele. Nooit echte waarden in dit bestand committen.

# --- Verplicht ---

# Postgres-connectiestring. Zelfde database die later ook pgvector gebruikt
# (zie docs/ARCHITECTURE.md). Geen SQLite, ook niet lokaal.
DATABASE_URI=postgres://user:password@localhost:5432/mijnleerlijn

# Willekeurige, geheime string — gebruikt door Payload om sessies/tokens te
# ondertekenen. Genereer bijv. met `openssl rand -base64 32`.
PAYLOAD_SECRET=

# --- Aanbevolen (heeft een development-fallback, verplicht in productie) ---

# Basis-URL van deze applicatie — gebruikt voor previewlinks en revalidatie.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Root-domein voor variant-subdomeinen/-paden (bijv. "mijnleerlijn.chat" —
# geen protocol, geen "www."). Bron van waarheid voor zowel de
# subdomein-/padherkenning (proxy.ts, lib/variant/in-memory-variant-resolver.ts)
# als de pad→subdomein-redirect en de "Open variant"-links in de admin-UI.
# Bewust een losse variabele, niet afgeleid uit een variant-record — zie
# config/env.ts se getRootDomain(). Development-fallback "localhost:3000".
NEXT_PUBLIC_ROOT_DOMAIN=mijnleerlijn.chat

# Vercel Blob (media-uploads + privé contactformulier-bijlagen). Alleen nodig
# wanneer je GEEN Vercel Blob store via OIDC aan dit project hebt gekoppeld
# (Vercel injecteert dan zelf BLOB_STORE_ID/VERCEL_OIDC_TOKEN, geen los token
# nodig — zie services/storage.ts). De Payload-mediaplugin voor de publieke
# `media`-collectie ondersteunt OIDC nog niet en heeft dit token dus altijd
# nodig voor persistente media-uploads op Vercel — zie payload.config.ts.
# Zonder token valt lokale ontwikkeling terug op schijfopslag.
BLOB_READ_WRITE_TOKEN=

# Resend (e-mailnotificatie bij een nieuwe contactinzending). Zonder deze
# variabele wordt de development-e-mailadapter gebruikt (logt naar console,
# verstuurt niets echt). Verplicht in productie.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=noreply@mijnleerlijn.nl
CONTACT_NOTIFICATION_EMAIL=helpdesk@mijnleerlijn.nl

# Gmail-helpdeskkoppeling (OAuth 2.0, alleen-lezen) — zie
# app/api/gmail/oauth/start en .../callback. Alleen nodig zodra je die
# koppeling daadwerkelijk gebruikt; zonder deze variabelen faalt alleen het
# koppelen zelf (geen crash elders). GMAIL_CLIENT_ID/SECRET komen uit de
# Google Cloud Console (OAuth-clientgegevens, type "Webtoepassing").
# GMAIL_REDIRECT_URI moet exact overeenkomen met wat daar als geautoriseerde
# redirect-URI staat, bv. https://<domein>/api/gmail/oauth/callback.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Losse sleutel om de opgeslagen Gmail-tokens mee te versleutelen
# (lib/gmail/encryption.ts, AES-256-GCM) — bewust niet PAYLOAD_SECRET
# hergebruikt (dat ondertekent Payload's eigen sessies, een ander
# beveiligingsdomein). Willekeurige lange string, bijv. `openssl rand -base64 32`.
GMAIL_TOKEN_ENCRYPTION_KEY=

# OpenAI API-sleutel voor de centrale AI-client (services/ai-client.ts),
# gebruikt door zowel de AI-analyse van supportthreads
# (app/api/support/analyze, lib/support/analyze.ts) als het indexeren
# (app/api/knowledge/index) en embedden (app/api/knowledge/embed,
# app/api/knowledge/search — Sprint 4, lib/embeddings/) van kennisbronnen.
# Alleen nodig zodra je die functies daadwerkelijk gebruikt; zonder deze
# variabele faalt alleen die actie (nette foutstatus, geen crash elders).
# Tot 2026-07-23 stond hier ANTHROPIC_API_KEY — overgezet op OpenAI, zie het
# commentaar bovenin services/ai-client.ts.
OPENAI_API_KEY=

# --- Optioneel ---

# Overschrijft het standaard AI-model (gpt-4o) voor de centrale AI-client
# (services/ai-client.ts).
AI_MODEL_ID=

# Overschrijft het standaard embedding-model (text-embedding-3-small) voor
# semantisch zoeken (Sprint 4, lib/embeddings/) — zelfde centrale AI-client.
EMBEDDING_MODEL_ID=

# Vercel Cron/andere geplande taken die interne routes aanroepen (bv.
# geplande publicatie, bijlage-opruiming) delen dit geheim ter verificatie.
CRON_SECRET=

# Helpdesk-beheerkoppeling (2026) — server-to-server toegang tot Curriculum
# Werkplaats' admin-API (/api/beheer/**, zie
# ARCHITECTUUR-HELPDESK-BEHEERKOPPELING.md in de Curriculum Werkplaats-
# codebase). CURRICULUM_ADMIN_API_URL is de basis-URL van die applicatie
# (bv. https://curriculum.mijnleerlijn.chat, geen trailing slash nodig).
# CURRICULUM_ADMIN_API_SECRET moet EXACT overeenkomen met Curriculum
# Werkplaats' eigen ADMIN_API_SECRET — zonder deze twee variabelen faalt
# alleen de beheerpagina "Curriculum Werkplaats" in /admin (nette 502, geen
# crash elders). Alleen nodig als je die pagina daadwerkelijk gebruikt.
CURRICULUM_ADMIN_API_URL=
CURRICULUM_ADMIN_API_SECRET=

# Sales-assistent V1 (2026-08-14) — server-naar-server toegang tot de
# monday.com CRM-API (https://api.monday.com/v2, GraphQL), zelfde
# statisch-token-patroon als CURRICULUM_ADMIN_API_SECRET hierboven (Monday
# werkt met één workspace-token, geen per-gebruiker OAuth zoals Gmail).
# Zonder deze variabele falen alleen de Sales-sync/schoolcontext/write-back
# (nette foutstatus, geen crash elders) — de rest van de Sales-module
# (datamodel, backfill-logica op reeds gesynchroniseerde data, UI) blijft
# werken. MONDAY_API_VERSION is optioneel en overschrijft de standaard
# API-versie — nog niet live geverifieerd tegen een echt Monday-account, zie
# lib/sales/monday-client.ts.
MONDAY_API_TOKEN=
MONDAY_API_VERSION=

# Cron-authenticatie voor de Sales-Monday-sync (app/api/sales/sync) —
# hergebruikt de bestaande CRON_SECRET hierboven, geen nieuwe variabele.
